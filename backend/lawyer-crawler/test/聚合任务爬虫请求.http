@baseUrl = http://localhost:8082/api/crawler

### 创建聚合法规内容爬虫任务
POST {{baseUrl}}/aggregationTasks
Content-Type: application/json

{
  "crawlRequests": [
    {
      "url": "http://www.npc.gov.cn/npc/c2/c12435",
      "strategy": "JSOUP",
      "selectorConfig": {
         "fieldSelectors": {
            "href": "a",
            "publishedAt": "span"
        },
        "listSelector": ".s_lw li",
        "selectorType": "CSS",
        "metadata": {
          "publishedInDays": 30
        }
      },
      "metadata": {
        "taskName": "中国人大网-权威发布",
        "description": "最多爬取前3页内容"
      },
      "pagination": {
        "urlSegments": ["/index.html", "/index_1.html", "/index_2.html"]
      }
    },
    {
